aws_region            = "ap-south-1"
project_name          = "task5-secops"
gitlab_url            = "https://gitlab.com"
gitlab_project_path   = "YOUR_GROUP/YOUR_PROJECT"
gitlab_ref             = "main"
state_bucket_arn       = "arn:aws:s3:::REPLACE_WITH_TF_STATE_BUCKET"
state_lock_table_arn   = "arn:aws:dynamodb:ap-south-1:123456789012:table/REPLACE_WITH_TF_LOCK_TABLE"
ami_id                 = "ami-REPLACE_WITH_CURRENT_UBUNTU_LTS_AMI"
audit_bucket_name      = "replace-with-globally-unique-audit-bucket-name"
alert_email            = ""
enable_nat_gateway     = true
